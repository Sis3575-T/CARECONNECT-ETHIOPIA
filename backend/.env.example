PORT=5000
NODE_ENV=development

# Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careconnect_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=careconnect_db
PGUSER=postgres
PGPASSWORD=postgres

# JWT Auth Tokens
JWT_SECRET=careconnect_dev_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=careconnect_dev_refresh_secret_change_in_production_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Microservices & CORS
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# Document Storage Limits
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
