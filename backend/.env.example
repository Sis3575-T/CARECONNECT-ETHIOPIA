# CareConnect Ethiopia - Backend Service Environment Template
# Copy to backend/.env before running locally: cp backend/.env.example backend/.env
# Never commit real credentials or production secrets to Git.

NODE_ENV=development
PORT=5000
HOST=0.0.0.0
API_BASE_URL=http://localhost:5000/api/v1
LOG_LEVEL=info

# Database Connection (PostgreSQL / Neon Cloud)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGDATABASE=careconnect_db
PGUSER=postgres
PGPASSWORD=

# JWT Cryptographic Secrets (At least 32 characters in production)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Permitted Frontend Portal Origins (Comma-separated)
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# External Services
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=15000
EXTERNAL_SERVICE_API_KEY=

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
