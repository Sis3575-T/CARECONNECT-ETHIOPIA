# CareConnect Ethiopia - Root Environment Configuration Template
# Copy this file to .env before starting services: cp .env.example .env
# SECURITY NOTICE: Never commit real credentials or production secrets to Git.

NODE_ENV=development

# Database Configuration (Neon PostgreSQL Cloud Connection)
# Format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL=

# Cryptographic Token Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Backward compatibility secret keys
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# Backend & AI Service Ports and Endpoints
BACKEND_PORT=5000
AI_SERVICE_PORT=8000

AI_SERVICE_URL=http://localhost:8000
VITE_API_URL=http://localhost:5000/api/v1

# Independent Frontend Portal Ports
HEALTH_CENTRE_PORT=5173
HOSPITAL_PORT=5174
TRANSPORT_PORT=5175
ADMIN_PORT=5176

# Cross-Origin Resource Sharing (Comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# External Integration Secret (Unidentified provider; confirmed upon integration phase)
EXTERNAL_SERVICE_API_KEY=
