# CareConnect Ethiopia - Root Environment Template
# Copy this file to .env or service-specific .env files before running

NODE_ENV=development

# Service Ports
HEALTH_CENTRE_PORT=5173
HOSPITAL_PORT=5174
TRANSPORT_PORT=5175
ADMIN_PORT=5176
BACKEND_PORT=5000
AI_SERVICE_PORT=8000

# Main API and AI Service URLs
VITE_API_URL=http://localhost:5000/api/v1
AI_SERVICE_URL=http://localhost:8000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careconnect_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=careconnect_db
PGUSER=postgres
PGPASSWORD=postgres

# Security Secrets (Do NOT commit real secrets)
JWT_SECRET=careconnect_dev_jwt_secret_change_in_production_min_32_chars
REFRESH_TOKEN_SECRET=careconnect_dev_refresh_secret_change_in_production_min_32_chars
