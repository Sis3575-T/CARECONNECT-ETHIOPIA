{
  "name": "careconnect-ethiopia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "portals/health-centre",
    "portals/hospital",
    "portals/transport",
    "portals/administrator",
    "backend"
  ],
  "scripts": {
    "server": "node server/server.js",
    "backend": "node backend/src/app.js",
    "db:migrate": "node database/migrate.js",
    "db:status": "node database/migrate.js --status",
    "db:seed": "node database/seed.js",
    "test:db": "node --test database/tests/**/*.test.js",
    "dev:backend": "node --watch backend/src/app.js",
    "dev:ai": "python -m uvicorn app.main:app --app-dir ai-service --port 8000 --reload",
    "dev:health": "vite --config portals/health-centre/vite.config.js portals/health-centre",
    "dev:hospital": "vite --config portals/hospital/vite.config.js portals/hospital",
    "dev:transport": "vite --config portals/transport/vite.config.js portals/transport",
    "dev:admin": "vite --config portals/administrator/vite.config.js portals/administrator",
    "dev:all": "concurrently -n \"SERVER:5000,HEALTH:5173,HOSPITAL:5174,TRANSPORT:5175,ADMIN:5176\" -c \"yellow.bold,cyan.bold,green.bold,magenta.bold,blue.bold\" \"npm run server\" \"npm run dev:health\" \"npm run dev:hospital\" \"npm run dev:transport\" \"npm run dev:admin\"",
    "check:ports": "node scripts/dev-orchestrator.js",
    "build:health": "vite build portals/health-centre --config portals/health-centre/vite.config.js",
    "build:hospital": "vite build portals/hospital --config portals/hospital/vite.config.js",
    "build:transport": "vite build portals/transport --config portals/transport/vite.config.js",
    "build:admin": "vite build portals/administrator --config portals/administrator/vite.config.js",
    "build:all": "npm run build:health && npm run build:hospital && npm run build:transport && npm run build:admin",
    "test:backend": "node --test backend/tests/**/*.test.js",
    "test:ai": "python -m pytest ai-service/tests",
    "test:all": "npm run test:backend"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "framer-motion": "^11.11.11",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.1",
    "react-is": "^19.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.6"
  }
}
